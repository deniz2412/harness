{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewFindings",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "severity", "message"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "severity": { "enum": ["info", "minor", "major", "critical"] },
          "message": { "type": "string" }
        }
      }
    }
  }
}
