FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/Harness.Api/Harness.Api.csproj -c Release -o /out

# M2 write path: the runner clones the target repo (git) and validates generated code
# (dotnet test) as subprocesses inside THIS container, so the runtime image needs both the .NET
# SDK and git — the slim aspnet runtime has neither. The SDK image is heavier; acceptable for the
# local PoC, and it is what a runner container would carry anyway once isolation graduates off-box.
FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out .
# The SDK image has no non-root `app` user (the aspnet image did), so create one: the runner must
# not execute cloned, untrusted repo code as root. A fresh named volume inherits ownership from the
# image directory it masks, so /data must be app-owned or every audit EmitAsync fails on write.
RUN useradd --uid 1654 --create-home --shell /usr/sbin/nologin app \
    && mkdir -p /data/audit-payloads /data/worktrees && chown -R app:app /data
USER app
# Quiet the SDK's first-run telemetry/noise for a service that only ever shells `git`/`dotnet test`.
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
ENTRYPOINT ["dotnet", "Harness.Api.dll"]
