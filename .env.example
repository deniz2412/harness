# Copy to .env (gitignored). The gateway is the ONLY service that sees the Anthropic key.
ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=github_pat_...          # fine-grained: contents:read, pull_requests:write, issues:read
POSTGRES_PASSWORD=harness-dev-only
GATEWAY_MASTER_KEY=local-dev-master  # harness -> gateway auth
