# Copy to .env (gitignored). The gateway is the ONLY service that sees the Anthropic key.
ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=github_pat_...          # fine-grained: contents:read, pull_requests:write, issues:read
GITHUB_OWNER=your-github-username    # target repo — use a throwaway repo until gates land (M1)
GITHUB_REPO=your-test-repo
POSTGRES_PASSWORD=harness-dev-only   # drives both postgres and the harness connection string
GATEWAY_MASTER_KEY=local-dev-master  # harness -> gateway auth
